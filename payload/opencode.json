{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "coarena": {
      "name": "Coarena",
      "env": [],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://coarena.ai/api/v1",
        "apiKey": "{env:COARENA_API_KEY}"
      },
      "models": {
        "gemini-3-8-flash": {
          "name": "Gemini 3.8 Flash",
          "limit": {
            "context": 128000
          }
        },
        "deepseek-v4-1-flash-1017": {
          "name": "DeepSeek v4.1 Flash",
          "limit": {
            "context": 128000
          }
        }
      }
    }
  },
  "experimental": {
    "todo": true,
    "background_compaction": true,
    "artifacts": true,
    "schedules": true
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": "20%"
  },
  "instructions": [
    "CLAUDE.md"
  ],
  "formatter": true,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.git/**"
    ]
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ],
  "plugins": [
    "./plugins/claude-parity",
    "@dietrichgebert/ponytail@5.3.3",
    "@hueyexe/opencode-ensemble@0.21.5",
    "./router-stats-desktop",
    "@slkiser/opencode-quota@6.3.0",
    "opencode-runtime-fallback@0.3.1"
  ],
  "provider": {
    "openai": {},
    "openrouter": {}
  }
}
